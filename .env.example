# ---------------------------------------------------------------------------
# Ipswich PIWC — environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Cloud Firestore is the system of record for all church data, accessed from
# the client with the Firebase Web SDK. There is no separate database URL.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase — client SDK config (safe to expose to the browser).
# Values come from the Firebase console: Project settings → Your apps → Web app.
# The VITE_ prefix is required for these to be available in client code.
# The People module (and all data modules) need these set to read/write data.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: web push (FCM) public VAPID key for Cloud Messaging in the browser.
VITE_FIREBASE_VAPID_KEY=

# Optional: set to "true" to use the local Firebase emulators for Firestore/Auth
# during development (run `firebase emulators:start`). Requires firebase-tools.
VITE_FIREBASE_USE_EMULATOR=

# ---------------------------------------------------------------------------
# Firebase Admin — server-only service account (NEVER expose to the browser).
# Only needed later for verifying auth tokens server-side (session is mocked
# for now). Provide the service account JSON as a single-line string, or set
# GOOGLE_APPLICATION_CREDENTIALS to a file path instead.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ---------------------------------------------------------------------------
# Celebration SMS (Cloud Functions only — never exposed to the browser).
# Set with `firebase functions:secrets:set NAME`, not in this file.
#
# Both switches default to SAFE: nothing sends until SMS_ENABLED is "true" AND
# SMS_DRY_RUN is "false". Leave the dry run on until the preview output looks
# right, or the first deploy will text the whole congregation.
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+441234567890

# Master switch. Anything other than "true" means no messages are sent.
SMS_ENABLED=false

# Anything other than "false" keeps the run in dry mode (logs, never sends).
SMS_DRY_RUN=true

# Optional: divert every message to one number while testing.
# SMS_TEST_NUMBER=+447700900123

# Safety cap on messages per daily run.
SMS_MAX_PER_RUN=50

# IANA zone used to decide what "today" is.
SMS_TIMEZONE=Europe/London
